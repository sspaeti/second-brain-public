RewriteEngine On

# CORS for public brain content. Brain pages are static HTML with no auth,
# no cookies, no sensitive data — wildcard ACAO is the textbook-recommended
# pattern (mirrors GitHub's public API, etc.). Browsers automatically
# block credential transmission when ACAO is "*", so a cross-origin
# fetcher gets exactly what anonymous curl would get and nothing more.
# Switched from dynamic origin reflection because Bunny CDN does not
# honour Vary: Origin, causing per-URL cache poisoning where the first
# request after each purge fixed the cached ACAO value for all later
# consumers of that URL. Wildcard returns one response for every origin,
# so the cache is consistent regardless of who hits first.
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
</IfModule>

# Cache lifetimes. Hugo fingerprints CSS/JS/JSON with an md5 in the file name
# (styles.<hash>.min.css, js/<name>.<hash>.min.js, indices/<name>.<hash>.min.json),
# so those never change in place and can be cached for a year. Fonts are
# stable files, 30 days. Everything else keeps the default (7 days via CDN).
# Note: the Bunny pull zone may override Cache-Control; check the edge
# response after a deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.[0-9a-f]{32}\.(min\.)?(css|js|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Redirect renamed brain articles to new URL
# List all renames below manually
RewriteRule ^onetable/?$ https://www.ssp.sh/brain/xtable [R=301,L]
RewriteRule ^data-engineering-blogs/?$ https://www.ssp.sh/brain/data-engineering-blogs-newsletters [R=301,L]
RewriteRule ^big-cloud-vendors/?$ https://www.ssp.sh/brain/cloud-data-provider [R=301,L]
RewriteRule ^learning-in-public/?$ https://www.ssp.sh/brain/learn-in-public [R=301,L]
RewriteRule ^write-from-the-heart/?$ https://www.ssp.sh/brain/writing-from-the-heart [R=301,L]
RewriteRule ^data-engineering-vault/?$ https://www.ssp.sh/brain/data-engineering [R=301,L]
RewriteRule ^data-engineering-blogs-newsletters?/?$ https://www.ssp.sh/brain/data-engineering-blogs-and-newsletters [R=301,L]
RewriteRule ^plaintext-files?/?$ https://www.ssp.sh/brain/plain-text-files [R=301,L]
RewriteRule ^computer-desk-setup-todays-office?/?$ https://www.ssp.sh/brain/computer-desk-setup-monitor-workflow [R=301,L]
RewriteRule ^the-ordinary-life?/?$ https://www.ssp.sh/brain/the-ordinary-boring-life [R=301,L]
RewriteRule ^on-writing?/?$ https://www.ssp.sh/brain/earn-attention-with-writing/ [R=301,L]
RewriteRule ^quartz-publish-obsidian-vault?/?$ https://www.ssp.sh/brain/quartz/ [R=301,L]
RewriteRule ^computer-desk-setup-monitor-workflow?/?$ https://www.ssp.sh/brain/computer-desk-setup-and-monitor-workflow/ [R=301,L]

# redirect old article URL to new
RewriteCond %{HTTP_HOST} ^ssp\.sh$
RewriteRule ^(.*)$ https://www.ssp.sh/brain/$1 [R=301,L]
